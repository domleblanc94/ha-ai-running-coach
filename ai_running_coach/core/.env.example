# Copy with setup_coach.py. Never commit the real .env.
COACH_PROVIDER=gemini
# New installs only; setup preserves existing explicit model selections.
# Free-tier availability/account quotas vary; see https://aistudio.google.com/docs/pricing
COACH_MODELS=gemini-3.5-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
# Set only for an explicitly chosen OpenAI-compatible endpoint.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
COACH_MAX_OUTPUT_TOKENS=4096
# Per direct coaching invocation, at most 2; the scheduled pipeline uses at most 1.
COACH_MAX_ATTEMPTS=2
# Normal request allowance per UTC day: 1 to 20. Does not change provider quotas.
COACH_MAX_DAILY_REQUESTS=2
COACH_ACTIVITY_SOURCE=offline
# Publishing off by default. Existing simple SCP upload.sh is optional.
COACH_PUBLISH_ENABLED=false
# Official Garmin Personal API only; never your Garmin account password.
GARMIN_PERSONAL_API_KEY=
GARMIN_PERSONAL_REGION=global
GARMIN_HTTP_TIMEOUT_SECONDS=30
GARMIN_MAX_REQUESTS_PER_RUN=100
GARMIN_BACKFILL_DAYS=56
